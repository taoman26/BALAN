<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BALAN.UI.ViewModels"
        xmlns:ctl="using:BALAN.UI.Controls"
        xmlns:conv="using:BALAN.UI.Converters"
        x:Class="BALAN.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="BALAN"
        Icon="avares://BALAN.UI/Assets/icon.png"
        Width="900" SizeToContent="Height"
        MinWidth="820"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- フッター: 状態メッセージ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource TitleBrush}"
            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Height="34">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                 Fill="{Binding IndicatorState, Converter={x:Static conv:ConnectionToBrushConverter.Instance}}" />
        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Classes="dim"
                   Text="{Binding FooterText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="dim" Text="Settings saved automatically" />
      </Grid>
    </Border>

    <Grid Margin="24,14,24,16" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,16,*">

      <!-- ヘッダー -->
      <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
        <StackPanel Spacing="2">
          <TextBlock Text="BALAN" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Balance Board Assisted Learning And Navigation" Classes="dim" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center" Margin="0,0,16,0" Text="{Binding BatteryText}" />
        <Border Grid.Column="2" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="16" Padding="14,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                     Fill="{Binding IndicatorState, Converter={x:Static conv:ConnectionToBrushConverter.Instance}}" />
            <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{Binding IndicatorState, Converter={x:Static conv:ConnectionToBrushConverter.Instance}}"
                       Text="{Binding StatusText}" />
          </StackPanel>
        </Border>
        <Button Grid.Column="3" Margin="12,0,0,0" Height="32" Width="136" Content="— Minimize to tray"
                ToolTip.Tip="Closing or minimizing hides BALAN in the system tray"
                Command="{Binding MinimizeToTrayCommand}" />
      </Grid>

      <!-- LOAD -->
      <Border Grid.Row="1" Grid.Column="0" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="LOAD   (kg per sensor)" />

          <Grid ColumnDefinitions="*,Auto">
            <Grid RowDefinitions="52,52" ColumnDefinitions="*,*" Width="270" HorizontalAlignment="Left">
              <Border Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <ProgressBar Orientation="Vertical" VerticalAlignment="Stretch" Minimum="0" Maximum="{Binding MeterMaxKg}" Value="{Binding TopLeftKg}" CornerRadius="0" />
                  <TextBlock Text="TL" FontWeight="Bold" Margin="8,6" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding TopLeftKg, StringFormat='{}{0:0.0} kg'}" Classes="mono" Margin="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
              <Border Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <ProgressBar Orientation="Vertical" VerticalAlignment="Stretch" Minimum="0" Maximum="{Binding MeterMaxKg}" Value="{Binding TopRightKg}" CornerRadius="0" />
                  <TextBlock Text="TR" FontWeight="Bold" Margin="8,6" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding TopRightKg, StringFormat='{}{0:0.0} kg'}" Classes="mono" Margin="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
              <Border Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <ProgressBar Orientation="Vertical" VerticalAlignment="Stretch" Minimum="0" Maximum="{Binding MeterMaxKg}" Value="{Binding BottomLeftKg}" CornerRadius="0" />
                  <TextBlock Text="BL" FontWeight="Bold" Margin="8,6" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding BottomLeftKg, StringFormat='{}{0:0.0} kg'}" Classes="mono" Margin="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
              <Border Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <ProgressBar Orientation="Vertical" VerticalAlignment="Stretch" Minimum="0" Maximum="{Binding MeterMaxKg}" Value="{Binding BottomRightKg}" CornerRadius="0" />
                  <TextBlock Text="BR" FontWeight="Bold" Margin="8,6" VerticalAlignment="Top" />
                  <TextBlock Text="{Binding BottomRightKg, StringFormat='{}{0:0.0} kg'}" Classes="mono" Margin="8,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="0">
              <TextBlock Text="Total" Classes="dim" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Text="kg" Classes="dim" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <!-- ペダル: 何 kg で効くかを見る -->
          <TextBlock Text="PEDALS" FontWeight="Bold" Classes="dim" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="96,*,64" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoBrush}" Text="{Binding PositiveLabel}" />
            <ctl:ForceMeter Grid.Row="0" Grid.Column="1" Value="{Binding ForceUp}" Maximum="{Binding MeterMaxKg}" Threshold="{Binding DeadZone}" Fill="{StaticResource GoBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ForceUp, StringFormat='{}{0:0.0} kg'}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoBrush}" Text="{Binding NegativeLabel}" />
            <ctl:ForceMeter Grid.Row="1" Grid.Column="1" Value="{Binding ForceDown}" Maximum="{Binding MeterMaxKg}" Threshold="{Binding DeadZone}" Fill="{StaticResource GoBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ForceDown, StringFormat='{}{0:0.0} kg'}" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrakeBrush}" Text="TL/BL  BRAKE" IsVisible="{Binding IsVertical}" />
            <ctl:ForceMeter Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsVertical}" Value="{Binding ForceBrake}" Maximum="{Binding MeterMaxKg}" Threshold="{Binding BrakeLoadKg}" Fill="{StaticResource BrakeBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsVertical}" Text="{Binding ForceBrake, StringFormat='{}{0:0.0} kg'}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- CRUISE -->
      <Border Grid.Row="1" Grid.Column="2" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="CRUISE" />

          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LevelText}" FontSize="36" FontWeight="Bold"
                         Foreground="{Binding Level, Converter={x:Static conv:LevelToBrushConverter.Instance}}" />
              <TextBlock Text="{Binding StateDetail}" Classes="dim" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
              <TextBlock Text="{Binding SpeedText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
              <TextBlock Text="notches / s" Classes="dim" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <UniformGrid Rows="1" Margin="-4,14,-4,0">
            <Border Classes="step stopped" Classes.active="{Binding IsStopped}"><TextBlock Text="Stopped" /></Border>
            <Border Classes="step slow" Classes.active="{Binding IsSlow}"><TextBlock Text="Slow" /></Border>
            <Border Classes="step medium" Classes.active="{Binding IsMedium}"><TextBlock Text="Medium" /></Border>
            <Border Classes="step fast" Classes.active="{Binding IsFast}"><TextBlock Text="Fast" /></Border>
          </UniformGrid>

          <ProgressBar Margin="0,14,0,0" Height="12" Minimum="0" Maximum="{Binding MaxSpeed}" Value="{Binding Speed}"
                       Foreground="{Binding Level, Converter={x:Static conv:LevelToBrushConverter.Instance}}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="0" Classes="dim" />
            <TextBlock Grid.Column="1" Text="{Binding MaxSpeed, StringFormat='{}{0} max'}" Classes="dim" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- SENSITIVITY -->
      <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Margin="0,14,0,0">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="SENSITIVITY" />

          <Grid ColumnDefinitions="150,*,70,200" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Dead Zone" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="4.0" Value="{Binding DeadZone}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DeadZone, StringFormat='{}{0:0.0} kg'}" />
            <TextBlock Grid.Row="0" Grid.Column="3" Classes="dim" VerticalAlignment="Center" Text="no reaction below this load" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Max Speed" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="40" Value="{Binding MaxSpeed}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding MaxSpeed, StringFormat='{}{0:0}'}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Classes="dim" VerticalAlignment="Center" Text="notches / s at full load" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Brake Threshold" IsEnabled="{Binding IsVertical}" />
            <Slider Grid.Row="2" Grid.Column="1" IsEnabled="{Binding IsVertical}" Minimum="1" Maximum="8" Value="{Binding BrakeLoadKg}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding BrakeLoadKg, StringFormat='{}{0:0.0} kg'}" />
            <TextBlock Grid.Row="2" Grid.Column="3" Classes="dim" VerticalAlignment="Center" Text="TL / BL load that brakes" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Brake Strength" IsEnabled="{Binding IsVertical}" />
            <Slider Grid.Row="3" Grid.Column="1" IsEnabled="{Binding IsVertical}" Minimum="0" Maximum="1" Value="{Binding BrakeStrength}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Classes="mono" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding BrakeStrength, StringFormat='{}{0:0.00}'}" />
            <TextBlock Grid.Row="3" Grid.Column="3" Classes="dim" VerticalAlignment="Center" Text="how fast the brake stops" />
          </Grid>

          <Border Height="1" Background="{StaticResource BorderBrush2}" Margin="0,4" />

          <Grid ColumnDefinitions="150,Auto,Auto,*">
            <TextBlock VerticalAlignment="Center" Text="Scroll Mode" />
            <RadioButton Grid.Column="1" GroupName="ScrollMode" Content="Vertical" IsChecked="{Binding IsVertical}" Margin="0,0,16,0" />
            <RadioButton Grid.Column="2" GroupName="ScrollMode" Content="Horizontal" IsChecked="{Binding IsHorizontal}" />
            <TextBlock Grid.Column="3" Classes="dim" VerticalAlignment="Center" Margin="16,0,0,0"
                       Text="Horizontal: right foot = right, left foot = left (no brake)" />
          </Grid>

          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Button Classes="primary" Width="126" Height="32" Content="{Binding CalibrateButtonText}"
                    Command="{Binding CalibrateCommand}" IsEnabled="{Binding !IsCalibrating}" />
            <TextBlock Grid.Column="1" Margin="16,0,0,0" Classes="dim" VerticalAlignment="Center"
                       Text="Rest your feet on the board (no pressing), then press." />
            <ToggleSwitch Grid.Column="3" OnContent="Scroll output" OffContent="Scroll output" IsChecked="{Binding ScrollEnabled}" Margin="0,0,16,0" />
            <Button Grid.Column="4" Width="110" Height="32" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
