<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BALAN.UI.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#4F8CFF" RegionColor="#1B1C21" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://BALAN.UI/Styles/BalanTheme.axaml" />
  </Application.Styles>
</Application>
