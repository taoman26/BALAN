<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- アイコンは assets/ のものを Assets/ として取り込む(gen_icon.py で再生成できる) -->
    <AvaloniaResource Include="..\..\assets\*.png" Link="Assets\%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="BALAN.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BALAN.Core\BALAN.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.8" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
  </ItemGroup>

</Project>
