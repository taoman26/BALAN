    <AssemblyName>BALAN</AssemblyName>
    <RootNamespace>BALAN.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BALAN.Core\BALAN.Core.csproj" />
    <ProjectReference Include="..\BALAN.Device\BALAN.Device.csproj" />
    <ProjectReference Include="..\BALAN.Input\BALAN.Input.csproj" />
    <ProjectReference Include="..\BALAN.UI\BALAN.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Avalonia 11.3.8 が引く 0.21.2 には既知の脆弱性(GHSA-xrw6-gwf8-vvr9)があるため、修正版へ上げる。 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BALAN.Tests" />
  </ItemGroup>
</Project>
